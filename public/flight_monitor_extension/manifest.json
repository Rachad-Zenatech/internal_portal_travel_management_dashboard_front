{
  "manifest_version": 3,
  "name": "Flight Explorer - Booking Monitor",
  "version": "1.0.0",
  "description": "Secure companion booking monitor for Travel Management Portal. Detects real-time confirmations on supported airlines (Air Canada).",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.aircanada.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Flight Explorer Booking Monitor"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.aircanada.com/*"
      ],
      "js": [
        "adapters/base_adapter.js",
        "adapters/air_canada.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
